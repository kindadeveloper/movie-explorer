{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "movie-explorer": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "type": "component"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "optimized": {
              "fileReplacements": [
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.optimized.ts"
                },
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.optimized.ts"
                }
              ],
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all",
              "styles": ["src/styles.optimized.scss"],
              "outputPath": "dist/optimized"
            },
            "unoptimized": {
              "fileReplacements": [
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.unoptimized.ts"
                },
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.unoptimized.ts"
                }
              ],
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none",
              "styles": ["src/styles.unoptimized.scss"],
              "outputPath": "dist/unoptimized"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "movie-explorer:build:production"
            },
            "development": {
              "buildTarget": "movie-explorer:build:development"
            },
            "optimized": {
              "buildTarget": "movie-explorer:build:optimized"
            },
            "unoptimized": {
              "buildTarget": "movie-explorer:build:unoptimized"
            }
          },
          "defaultConfiguration": "unoptimized"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          }
        }
      }
    }
  }
}
